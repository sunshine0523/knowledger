#!/usr/bin/env bash
# PostToolUse hook — marks the current session as having made code edits.
# The Stop hook uses this marker to decide whether to trigger a knowledger-
# based code review before finishing.
set -euo pipefail

input=$(cat)

session_id=$(printf '%s' "$input" | python3 -c "
import sys, json
try:
    print(json.load(sys.stdin).get('session_id', ''))
except Exception:
    print('')
" 2>/dev/null)

[ -z "$session_id" ] && exit 0

marker_dir="${TMPDIR:-/tmp}/knowledger-hooks"
mkdir -p "$marker_dir" 2>/dev/null || exit 0
touch "${marker_dir}/edits-${session_id}.marker" 2>/dev/null || true

exit 0
