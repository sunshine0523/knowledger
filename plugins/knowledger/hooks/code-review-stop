#!/usr/bin/env bash
# Stop hook — when Claude finishes and the session touched files via
# Edit/Write/MultiEdit/NotebookEdit, force a knowledger-driven code review
# against the project's saved coding standards before letting the turn end.
#
# Loop prevention: relies on Claude Code's `stop_hook_active` field. When the
# hook returns decision:block, Claude continues with the reason; when it
# stops again, this hook receives stop_hook_active=true and exits cleanly.
set -euo pipefail

input=$(cat)

parse() {
    printf '%s' "$input" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    v = d.get('$1', '')
    if isinstance(v, bool):
        print('true' if v else 'false')
    else:
        print(v)
except Exception:
    print('')
" 2>/dev/null
}

session_id=$(parse session_id)
stop_hook_active=$(parse stop_hook_active)

marker_dir="${TMPDIR:-/tmp}/knowledger-hooks"
marker="${marker_dir}/edits-${session_id}.marker"

# Recursion guard — this Stop invocation is a follow-up we ourselves caused.
if [ "$stop_hook_active" = "true" ]; then
    rm -f "$marker" 2>/dev/null || true
    exit 0
fi

[ -z "$session_id" ] && exit 0
[ ! -f "$marker" ] && exit 0

project_dir="${CLAUDE_PROJECT_DIR:-$PWD}"

# Opt-out flag — users can drop this file to disable per-project CR.
if [ -f "${project_dir}/.knowledger/skip-code-review" ]; then
    rm -f "$marker" 2>/dev/null || true
    exit 0
fi

if ! command -v git >/dev/null 2>&1; then
    rm -f "$marker" 2>/dev/null || true
    exit 0
fi

cd "$project_dir" 2>/dev/null || exit 0

if ! git rev-parse --git-dir >/dev/null 2>&1; then
    rm -f "$marker" 2>/dev/null || true
    exit 0
fi

# Tracked + staged changes only. Untracked (??) and ignored (!!) are skipped
# so we do not review generated files, node_modules, build artifacts, etc.
changed=$(git status --porcelain 2>/dev/null | awk '$1 !~ /^\?/ && $1 !~ /^!/ {print $2}' | head -50)

if [ -z "$changed" ]; then
    rm -f "$marker" 2>/dev/null || true
    exit 0
fi

# One review per edit cycle — consume the marker now.
rm -f "$marker" 2>/dev/null || true

# Build changed_files args for knowledger lint
changed_files_args=""
while IFS= read -r f; do
    changed_files_args="$changed_files_args --changed-files $f"
done <<< "$changed"

lint_result=""
if command -v knowledger >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    lint_result=$(knowledger lint $changed_files_args 2>/dev/null || true)
fi

if [ -z "$lint_result" ] || [ "$lint_result" = '{"findings":null,"rule_sets":null}' ] || [ "$lint_result" = '{"findings":[],"rule_sets":[]}' ]; then
    exit 0
fi

LINT_RESULT="$lint_result" python3 -c "
import json, os
result = os.environ.get('LINT_RESULT', '{}')
reason = '''Lint checks completed. Apply the minimal fixes required by the findings below, citing each spec_id.

- findings: apply fixes for must-fix and should-fix items.
- rule_sets: compare the diff against these rules and fix any violations.
- If both are empty, report \"no violations\" and finish.

LintResult:
''' + result
print(json.dumps({'decision': 'block', 'reason': reason}))
" 2>/dev/null || echo '{}'

exit 0
